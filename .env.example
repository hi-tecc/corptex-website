# Public URL of the site (canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://corptex.be

# Sub-path when hosted on e.g. GitHub Pages without a custom domain ("/corptex-website").
# Leave empty when served from the domain root.
NEXT_PUBLIC_BASE_PATH=

# Contact form endpoint. Formspree: https://formspree.io/f/<id>  |  Web3Forms: https://api.web3forms.com/submit
# When empty, the contact form is hidden (contact details and map are still shown).
NEXT_PUBLIC_FORM_ENDPOINT=
# Only for Web3Forms: the public access key (safe to expose in the browser)
NEXT_PUBLIC_WEB3FORMS_KEY=
